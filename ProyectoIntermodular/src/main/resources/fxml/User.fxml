<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.ContextMenu?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<!--
    Panel principal de gestión de usuarios.
    Tamaño fijo: 900 × 600 px (igual que el resto de pantallas).
-->
<BorderPane
    prefHeight="600.0"
    prefWidth="900.0"
    stylesheets="@../styles/Styles.css"
    xmlns="http://javafx.com/javafx/21"
    xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="com.damianqm.proyectoIntermodular.controller.UserController">

    <!-- ══════════════ Barra de menú superior ══════════════ -->
    <top>
        <MenuBar BorderPane.alignment="TOP_LEFT">
            <menus>
                <Menu mnemonicParsing="false" text="File">
                    <items>
                        <MenuItem mnemonicParsing="false" onAction="#exit" text="Exit" />
                    </items>
                </Menu>
                <Menu mnemonicParsing="false" text="Edit">
                    <items>
                        <MenuItem mnemonicParsing="false" onAction="#deleteUsers" text="Delete" />
                    </items>
                </Menu>
                <Menu mnemonicParsing="false" text="Help">
                    <items>
                        <MenuItem mnemonicParsing="false" onAction="#showHelp" text="Help" />
                    </items>
                </Menu>
            </menus>
        </MenuBar>
    </top>

    <!-- ══════════════ Panel izquierdo – formulario ══════════════ -->
    <left>
        <VBox
            prefWidth="280.0"
            spacing="10.0"
            styleClass="background"
            BorderPane.alignment="CENTER">

            <padding>
                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
            </padding>

            <Label text="Add New User" textFill="WHITE">
                <font><Font size="18.0" /></font>
                <VBox.margin><Insets bottom="8.0" left="10.0" top="20.0" /></VBox.margin>
            </Label>

            <!-- ID (solo lectura, se rellena al editar) -->
            <HBox prefHeight="26.0" alignment="CENTER_LEFT">
                <Label text="User ID – " textFill="#f8f7f7">
                    <font><Font size="13.0" /></font>
                </Label>
                <Label fx:id="userId" textFill="WHITE">
                    <font><Font size="13.0" /></font>
                    <HBox.margin><Insets left="4.0" /></HBox.margin>
                </Label>
                <VBox.margin><Insets left="10.0" /></VBox.margin>
            </HBox>

            <TextField
                fx:id="firstName"
                prefHeight="30.0"
                prefWidth="240.0"
                promptText="First Name"
                accessibleText="Nombre" />

            <TextField
                fx:id="lastName"
                prefHeight="30.0"
                prefWidth="240.0"
                promptText="Last Name"
                accessibleText="Apellido" />

            <DatePicker
                fx:id="dob"
                editable="false"
                prefHeight="30.0"
                prefWidth="240.0"
                promptText="Date of Birth"
                accessibleText="Fecha de nacimiento" />

            <HBox alignment="CENTER_LEFT" spacing="15.0">
                <RadioButton
                    fx:id="rbMale"
                    mnemonicParsing="false"
                    selected="true"
                    text="Male"
                    textFill="WHITE"
                    accessibleText="Género masculino">
                    <toggleGroup><ToggleGroup fx:id="gender" /></toggleGroup>
                </RadioButton>
                <RadioButton
                    fx:id="rbFemale"
                    mnemonicParsing="false"
                    text="Female"
                    textFill="WHITE"
                    toggleGroup="$gender"
                    accessibleText="Género femenino" />
            </HBox>

            <ComboBox
                fx:id="cbRole"
                prefHeight="30.0"
                prefWidth="240.0"
                promptText="Select Role"
                accessibleText="Rol del usuario" />

            <TextField
                fx:id="email"
                prefHeight="30.0"
                prefWidth="240.0"
                promptText="Email"
                accessibleText="Correo electrónico" />

            <PasswordField
                fx:id="password"
                prefHeight="30.0"
                prefWidth="240.0"
                promptText="Password"
                accessibleText="Contraseña" />

            <!-- Botones Reset / Save -->
            <HBox prefHeight="34.0" spacing="10.0" alignment="CENTER_RIGHT">
                <Button
                    fx:id="reset"
                    mnemonicParsing="false"
                    onAction="#reset"
                    prefHeight="30.0"
                    prefWidth="80.0"
                    style="-fx-background-color: white;"
                    text="Reset"
                    accessibleText="Limpiar formulario">
                    <effect><DropShadow blurType="ONE_PASS_BOX" color="#1965d0" /></effect>
                </Button>
                <Button
                    fx:id="saveUser"
                    mnemonicParsing="false"
                    onAction="#saveUser"
                    prefHeight="30.0"
                    prefWidth="80.0"
                    styleClass="btnGreen"
                    text="Save"
                    textFill="WHITE"
                    accessibleText="Guardar usuario">
                    <font><Font size="13.0" /></font>
                    <effect><DropShadow blurType="ONE_PASS_BOX" color="#6468b2" /></effect>
                </Button>
                <VBox.margin><Insets top="4.0" /></VBox.margin>
            </HBox>

        </VBox>
    </left>

    <!-- ══════════════ Centro – tabla de usuarios ══════════════ -->
    <center>
        <VBox BorderPane.alignment="CENTER">

            <!-- Barra superior: espaciador + botón ? + botón Logout -->
            <HBox alignment="CENTER_RIGHT" prefHeight="40.0">
                <Region HBox.hgrow="ALWAYS" />
                <Button
                    fx:id="btnHelp"
                    mnemonicParsing="false"
                    onAction="#showHelp"
                    styleClass="btnHelp"
                    text="?"
                    accessibleText="Abrir ayuda">
                    <tooltip><Tooltip text="Ayuda (F1)" /></tooltip>
                    <HBox.margin><Insets right="6.0" top="5.0" /></HBox.margin>
                </Button>
                <Button
                    fx:id="btnLogout"
                    mnemonicParsing="false"
                    onAction="#logout"
                    prefHeight="28.0"
                    prefWidth="90.0"
                    styleClass="background"
                    text="Logout"
                    textFill="#fff9f9"
                    accessibleText="Cerrar sesión">
                    <font><Font size="13.0" /></font>
                    <HBox.margin><Insets right="8.0" top="5.0" /></HBox.margin>
                    <effect><DropShadow blurType="ONE_PASS_BOX" color="#00000091" /></effect>
                </Button>
            </HBox>

            <!-- Tabla de usuarios -->
            <TableView
                fx:id="userTable"
                VBox.vgrow="ALWAYS"
                tableMenuButtonVisible="true"
                accessibleText="Tabla de usuarios">

                <columns>
                    <TableColumn fx:id="colUserId"    prefWidth="40.0"  text="ID" />
                    <TableColumn fx:id="colFirstName"  prefWidth="90.0"  text="First Name" />
                    <TableColumn fx:id="colLastName"   prefWidth="90.0"  text="Last Name" />
                    <TableColumn fx:id="colDOB"        prefWidth="100.0" text="Date of Birth" />
                    <TableColumn fx:id="colGender"     prefWidth="65.0"  text="Gender" />
                    <TableColumn fx:id="colRole"       prefWidth="65.0"  text="Role" />
                    <TableColumn fx:id="colEmail"      prefWidth="150.0" text="Email" />
                    <TableColumn fx:id="colEdit"       prefWidth="60.0"  text="Edit" />
                </columns>

                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                </columnResizePolicy>

                <VBox.margin><Insets bottom="5.0" left="8.0" right="8.0" top="0.0" /></VBox.margin>

                <!-- Menú contextual (clic derecho sobre la tabla) -->
                <contextMenu>
                    <ContextMenu>
                        <items>
                            <MenuItem
                                fx:id="deleteUsersContextMenu"
                                mnemonicParsing="false"
                                onAction="#deleteUsers"
                                text="Delete" />
                        </items>
                    </ContextMenu>
                </contextMenu>

            </TableView>

        </VBox>
    </center>

</BorderPane>
